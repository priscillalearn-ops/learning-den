isy","dirty","busy"],0,"quiet (adj.) 安靜的"],["My sister likes to ____ songs.",["eat","read","sing","cook"],2,"sing (v.) 唱歌"],["There are seven days in a ____.",["week","day","month","year"],0,"week (n.) 星期；週"],["Wednesday comes after ____.",["Thursday","Tuesday","Monday","Sunday"],1,"Tuesday (n.) 星期二"],["I drink ____ every morning. It's good for me.",["noodles","bread","milk","rice"],2,"milk (n.) 牛奶"],["A doctor works in a ____.",["bank","school","zoo","hospital"],3,"hospital (n.) 醫院"],["Please ____ the window. It's cold.",["clean","paint","close","open"],2,"close (v.) 關上"],["My grandpa is eighty, but he is very ____.",["healthy","young","short","sick"],0,"healthy (adj.) 健康的"],["Look! The baby is ____. Don't wake her up.",["sleeping","running","singing","jumping"],0,"sleep (v.) 睡覺"],["We can see many animals at the ____.",["bank","zoo","library","bookstore"],1,"zoo (n.) 動物園"],["I use an ____ to fix my mistakes.",["eraser","ruler","marker","crayon"],0,"eraser (n.) 橡皮擦"],["Summer is ____. Let's go swimming.",["hot","cool","snowy","cold"],0,"hot (adj.) 熱的"],["Ten plus five is ____.",["fifteen","fifty","five","twenty"],0,"fifteen (n.) 十五"],["My ____ is a teacher. She teaches English.",["mother","brother","father","uncle"],0,"mother (n.) 媽媽"],["I have a ____. I need to see a doctor.",["homework","headache","hamburger","holiday"],1,"headache (n.) 頭痛"],["Birds can ____ in the sky.",["swim","fly","cook","sit"],1,"fly (v.) 飛"],["It's dark. Please turn ____ the light.",["on","at","off","in"],0,"turn on (phr.) 打開（電燈、電器）"],["The ____ is yellow and long. Monkeys love it.",["banana","grape","watermelon","apple"],0,"banana (n.) 香蕉"],["I go to school by ____. It's number 25.",["bike","bus","boat","foot"],1,"bus (n.) 公車"],["It's seven in the morning. It's time for ____.",["breakfast","dinner","winter","bed"],0,"breakfast (n.) 早餐"],["Don't ____ in the classroom. It's dangerous.",["write","listen","read","run"],3,"run (v.) 跑"],["My favorite ____ is basketball.",["animal","sport","food","color"],1,"sport (n.) 運動"],["Twelve months make one ____.",["week","hour","day","year"],3,"year (n.) 年"],["My shoes are too ____. I need a bigger pair.",["big","small","tall","long"],1,"small (adj.) 小的"],["Wash your ____ before you eat.",["feet","ears","eyes","hands"],3,"hand (n.) 手"],["The ____ is very tall. It has a long neck.",["rabbit","penguin","giraffe","mouse"],2,"giraffe (n.) 長頸鹿"],["I'm ____. I want to go to bed.",["thirsty","angry","hungry","sleepy"],3,"sleepy (adj.) 想睡的"],["We buy food and drinks at the ____.",["post office","hospital","library","supermarket"],3,"supermarket (n.) 超級市場"],["There are no clouds. The sky is ____ today.",["green","black","blue","gray"],2,"blue (adj.) 藍色的"],["My brother can ____ the piano.",["do","make","go","play"],3,"play (v.) 彈奏；玩"],["Kevin is my good ____. We play together every day.",["teacher","doctor","parent","friend"],3,"friend (n.) 朋友"],["The wind is strong. It's ____ today.",["snowy","windy","sunny","rainy"],1,"windy (adj.) 颳風的"],["I ____ my homework after dinner.",["take","do","play","make"],1,"do homework (phr.) 寫功課"],["A ____ gives us milk.",["duck","dog","cat","cow"],3,"cow (n.) 母牛"],["My father drives a ____ to work.",["train","boat","car","plane"],2,"car (n.) 汽車"],["January is the ____ month of the year.",["third","last","second","first"],3,"first (adj.) 第一的"],["She is ____. She is crying.",["sad","funny","happy","glad"],0,"sad (adj.) 傷心的"],["Please ____ your name on the paper.",["sing","eat","read","write"],3,"write (v.) 寫"],["The ice cream is ____. I love it!",["angry","dirty","terrible","delicious"],3,"delicious (adj.) 美味的"],["We have English class on ____ and Friday.",["spring","Monday","morning","June"],1,"Monday (n.) 星期一"]],"g":[],"c":[]},{"id":"GG","pub":"全民英檢初級風格","grade":"國小","name":"英檢初級　文法","short":"英檢初級","src":{"g":"文法"},"tags":{"g":"文法"},"v":[],"g":[["She ____ a student.",["be","is","are","am"],1,"She 是第三人稱單數，be 動詞用 is。"],["They ____ my classmates.",["are","is","be","am"],0,"They 是複數，be 動詞用 are。"],["I ____ happy today.",["is","be","are","am"],3,"I 的 be 動詞用 am。"],["My brother ____ soccer every day.",["playing","plays","play","is play"],1,"主詞是第三人稱單數，現在簡單式動詞要加 s。"],["Look! The children ____ in the park.",["are playing","is play","plays","play"],0,"Look! 表示正在發生，用現在進行式 be + V-ing。"],["____ you like apples? Yes, I do.",["Are","Do","Does","Is"],1,"一般動詞的問句，主詞 you 用 Do。"],["____ your sister like cats?",["Are","Does","Is","Do"],1,"your sister 是第三人稱單數，問句用 Does。"],["There ____ two books on the desk.",["is","are","am","be"],1,"There are + 複數名詞。"],["There ____ a cat under the chair.",["are","am","be","is"],3,"There is + 單數名詞。"],["This is ____ umbrella.",["many","a","an","two"],2,"umbrella 是母音開頭，用 an。"],["I have ____ dog. It is very cute.",["a","an","two","many"],0,"dog 是子音開頭的單數名詞，用 a。"],["I get up ____ seven o'clock.",["at","on","in","of"],0,"幾點鐘前面用 at。"],["My birthday is ____ May.",["on","in","of","at"],1,"月份前面用 in。"],["We don't go to school ____ Sunday.",["at","in","of","on"],3,"星期幾前面用 on。"],["This is Amy. ____ is my best friend.",["She","Her","It","He"],0,"Amy 是女生，當主詞用 She。"],["Tom and I are brothers. ____ live in Taipei.",["We","He","They","Us"],0,"Tom and I 就是 We。"],["Is this your pen? No, it's not ____.",["mine","my","I","me"],0,"mine 等於 my pen。"],["Please help ____. I can't open the box.",["my","me","mine","I"],1,"動詞 help 後面接受詞 me。"],["I ____ to the zoo yesterday.",["go","went","going","goes"],1,"yesterday 用過去式，go 的過去式是 went。"],["She ____ TV last night.",["watches","watched","watching","watch"],1,"last night 用過去式。"],["____ you at home yesterday?",["Were","Did","Are","Was"],0,"you 的過去式 be 動詞是 were。"],["He can ____ very fast.",["runs","ran","run","running"],2,"can 後面接原形動詞。"],["I will ____ my grandma tomorrow.",["visit","visits","visited","visiting"],0,"will 後面接原形動詞。"],["An elephant is ____ than a dog.",["biggest","more big","big","bigger"],3,"比較兩個東西用比較級 bigger than。"],["Today is the ____ day of my life!",["happy","happier","happiest","most happy"],2,"the + 最高級 happiest。"],["____ is your birthday? It's in June.",["When","What color","Where","Who"],0,"問時間用 When。"],["____ is the bathroom? It's next to the kitchen.",["When","Who","How","Where"],3,"問地點用 Where。"],["____ apples do you want? Three, please.",["How many","How much","How old","What time"],0,"可數名詞問數量用 How many。"],["____ is this T-shirt? It's 200 dollars.",["How many","How much","How long","How old"],1,"問價錢用 How much。"],["____ old are you? I'm ten.",["Who","Where","What","How"],3,"How old 問年齡。"],["I don't have ____ money.",["some","a","many","any"],3,"否定句用 any。"],["Would you like ____ tea?",["some","a","many","any"],0,"請別人吃喝東西的問句用 some。"],["Let's ____ to the park.",["going","went","go","goes"],2,"Let's 後面接原形動詞。"],["Don't ____ late for school.",["be","being","is","are"],0,"否定祈使句：Don't + 原形動詞。"],["My father ____ coffee. He drinks tea.",["doesn't drink","isn't drink","not drink","don't drink"],0,"第三人稱單數的否定：doesn't + 原形動詞。"],["Whose bag is this? It's ____.",["Mary's","Mary","Marys","of Mary"],0,"名字的所有格加 ’s。"],["I enjoy ____ comic books.",["reads","read","to read","reading"],3,"enjoy 後面接 V-ing。"],["He is good at ____.",["swim","swimming","swims","swam"],1,"介系詞 at 後面接 V-ing。"],["It's 7:30. I'm ____ breakfast now.",["having","had","have","has"],0,"now 表示正在做，用 be + V-ing。"],["Two cats ____ on the sofa.",["are sleeping","is sleeping","am sleeping","sleeps"],0,"Two cats 是複數，用 are + V-ing。"]],"c":[]},{"id":"GD","pub":"全民英檢初級風格","grade":"國小","name":"英檢初級　對話回應","short":"英檢初級","src":{"c":"對話回應"},"tags":{"c":"對話"},"v":[],"g":[],"c":[["A: How are you?　B: ____",["I'm a student.","I'm fine, thank you.","I'm from Taiwan.","I'm ten years old."],1,"How are you? 問你好不好，回答心情或身體狀況。"],["A: Nice to meet you.　B: ____",["I'm sorry.","Nice to meet you, too.","Goodbye.","You're welcome."],1,"第一次見面的回答：Nice to meet you, too."],["A: Thank you for your help.　B: ____",["Yes, please.","I'm fine.","See you.","You're welcome."],3,"別人道謝時回答 You're welcome.（不客氣）"],["A: I'm sorry I'm late.　B: ____",["That's OK.","You're welcome.","Me too.","Good idea."],0,"別人道歉時回答 That's OK.（沒關係）"],["A: What's your name?　B: ____",["It's Monday.","I'm fine.","I'm twelve.","My name is Lily."],3,"問名字就回答名字。"],["A: What time is it?　B: ____",["It's Friday.","It's my pen.","It's three o'clock.","It's sunny."],2,"What time 問幾點。"],["A: What day is today?　B: ____",["It's hot.","It's my book.","It's Thursday.","It's ten thirty."],2,"What day 問星期幾。"],["A: How's the weather today?　B: ____",["It's in the box.","It's rainy.","It's Sunday.","It's eight o'clock."],1,"問天氣就回答晴天、下雨等。"],["A: Can I use your eraser?　B: ____",["Sure. Here you are.","Yes, I am.","It's blue.","No, I can't swim."],0,"借東西時，Here you are. 是「拿去吧」。"],["A: Would you like some juice?　B: ____",["Here you are.","Yes, I do like.","Yes, please.","No, I'm not."],2,"有人請你喝東西，要就說 Yes, please."],["A: Where is my bag?　B: ____",["It's red.","It's under your desk.","It's mine.","It's Monday."],1,"Where 問地點，回答在哪裡。"],["A: Happy birthday!　B: ____",["You're welcome.","Me too.","Thank you!","Happy birthday!"],2,"別人祝你生日快樂，要說謝謝。"],["A: Let's play basketball after school.　B: ____",["Here you are.","I'm sorry to hear that.","Good idea!","You're welcome."],2,"別人邀約，同意時說 Good idea!"],["A: How old is your brother?　B: ____",["He's fine.","He's a student.","He's tall.","He's eight."],3,"How old 問年齡。"],["A: What do you want to be in the future?　B: ____",["I want to be a pilot.","I went to the zoo.","I'm in the kitchen.","I like pizza."],0,"問將來想做什麼工作。"],["A: Whose cap is this?　B: ____",["It's Jack's.","It's 100 dollars.","It's black.","It's on the chair."],0,"Whose 問是誰的。"],["A: How do you go to school?　B: ____",["With my book.","In the morning.","By bike.","At seven."],2,"How 問交通方式，by + 交通工具。"],["A: What are you doing?　B: ____",["I'm a student.","I like homework.","I'm doing my homework.","I did my homework."],2,"問正在做什麼，用 I'm + V-ing 回答。"],["A: May I come in?　B: ____",["I'm in.","Yes, I may.","No, you aren't.","Sure. Come in."],3,"May I...? 是請求允許，同意說 Sure."],["A: I have a cold.　B: ____",["I'm sorry to hear that.","That's great!","You're welcome.","Happy New Year!"],0,"聽到壞消息說 I'm sorry to hear that."],["A: How much is this pencil?　B: ____",["I have two.","It's ten dollars.","It's long.","It's yellow."],1,"How much 問價錢。"],["A: Do you have any brothers or sisters?　B: ____",["No, I can't.","I'm in grade five.","Yes, she is.","Yes, I have one sister."],3,"用 Do 問，回答 Yes, I have... 或 No, I don't."],["A: What's your favorite food?　B: ____",["I play baseball.","I like noodles.","I like green.","I'm hungry."],1,"問最喜歡的食物。"],["A: Goodbye!　B: ____",["See you tomorrow!","How are you?","Good morning!","Nice to meet you."],0,"道別時說 See you."],["A: Can you swim?　B: ____",["Yes, I am.","Yes, I can.","Yes, it is.","Yes, I do."],1,"用 Can 問，就用 can 回答。"],["A: Is this your dog?　B: ____",["No, I'm not.","No, they aren't.","No, it doesn't.","No, it isn't."],3,"Is this...? 用 it is / it isn't 回答。"],["A: Where are you from?　B: ____",["I'm fine.","I'm from Taiwan.","I'm eleven.","I'm at school."],1,"Where are you from? 問你從哪裡來。"],["A: What color is your bike?　B: ____",["It's fast.","It's mine.","It's new.","It's green."],3,"What color 問顏色。"],["A: Excuse me. Where is the library?　B: ____",["Yes, it is.","Go straight. It's on your left.","It opens at nine.","I like books."],1,"問路時，回答怎麼走。"],["A: Let's have lunch together.　B: ____",["I'm sorry to hear that.","Nice to meet you.","You're welcome.","Sure. Where do you want to go?"],3,"答應邀約：Sure."]]}],"presets":[{"name":"看圖＋字彙","ids":["GP","GV"]},{"name":"文法＋對話","ids":["GG","GD"]}]}